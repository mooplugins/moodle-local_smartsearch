    @template local_smartsearch/result_item

    Example context (json):
    {
        "id": "1",
        "recordid": "42",
        "recordtype": "course",
        "icon": "i/course",
        "typelabel": "Courses",
        "isuser": false,
        "haspicture": false,
        "pictureurl": "",
        "initials": "",
        "url": "/course/view.php?id=2",
        "titlehtml": "Example <mark>course</mark>",
        "hassubtitle": true,
        "subtitlehtml": "Category path",
        "hascontextpath": false,
        "hasactions": true,
        "actions": [
            {"url": "/course/view.php?id=2", "label": "View", "icon": "i/preview"}
        ]
    }
}}
<div class="smartsearch-result-item" data-id="{{id}}" data-recordid="{{recordid}}" data-recordtype="{{recordtype}}">
    <a href="{{url}}" class="smartsearch-result-link">
        <span class="smartsearch-result-icon{{#isuser}} smartsearch-result-avatar{{/isuser}}" title="{{typelabel}}" aria-hidden="true">
            {{#isuser}}
                {{#haspicture}}
                    <img class="userpicture" src="{{pictureurl}}" alt="" width="35" height="35">
                {{/haspicture}}
                {{^haspicture}}
                    <span class="userinitials size-35">{{initials}}</span>
                {{/haspicture}}
            {{/isuser}}
            {{^isuser}}
                {{#pix}}{{icon}}, core, {{typelabel}}{{/pix}}
            {{/isuser}}
        </span>
        <span class="smartsearch-result-body">
            <span class="smartsearch-result-title">{{{titlehtml}}}</span>
            {{#hassubtitle}}
            <span class="smartsearch-result-subtitle">{{{subtitlehtml}}}</span>
            {{/hassubtitle}}
            {{#hascontextpath}}
            <span class="smartsearch-result-context">{{{contexthtml}}}</span>
            {{/hascontextpath}}
        </span>
        <span class="smartsearch-result-go" aria-hidden="true">
            {{#pix}}i/next, core{{/pix}}
        </span>
    </a>
    {{#hasactions}}
    <div class="smartsearch-result-actions">
        {{#actions}}
        <a href="{{url}}" class="smartsearch-action">
            {{#pix}}{{icon}}, core, {{label}}{{/pix}}
            <span>{{label}}</span>
        </a>
        {{/actions}}
    </div>
    {{/hasactions}}
</div>
