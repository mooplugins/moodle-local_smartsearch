    @template local_smartsearch/result_item

    Example context (json):
    {
        "id": "1",
        "recordid": "42",
        "recordtype": "course",
        "icon": "course",
        "iconfa": "fa-solid fa-book",
        "typelabel": "Courses",
        "haspicture": false,
        "pictureurl": "",
        "url": "/course/view.php?id=2",
        "titlehtml": "Example <mark>course</mark>",
        "hassubtitle": true,
        "subtitlehtml": "Category path  •  Enrolled users: 12"
    }
}}
<div class="list-group-item list-group-item-action smartsearch-result-item border-0 py-2 px-3 rounded"
     data-id="{{id}}"
     data-recordid="{{recordid}}"
     data-recordtype="{{recordtype}}">
    <a href="{{url}}" class="smartsearch-result-link">
        <span class="smartsearch-result-icon{{#haspicture}} smartsearch-result-avatar{{/haspicture}}" title="{{typelabel}}" aria-hidden="true">
            {{#haspicture}}
                <img class="userpicture" src="{{pictureurl}}" alt="" width="32" height="32">
            {{/haspicture}}
            {{^haspicture}}
                {{#pix}}{{icon}}, local_smartsearch, {{typelabel}}{{/pix}}
                <i class="icon {{iconfa}} smartsearch-type-fa" aria-hidden="true"></i>
            {{/haspicture}}
        </span>
        <span class="smartsearch-result-body">
            <span class="smartsearch-result-title fw-semibold">{{{titlehtml}}}</span>
            {{#hassubtitle}}
            <span class="smartsearch-result-subtitle small text-muted">{{{subtitlehtml}}}</span>
            {{/hassubtitle}}
        </span>
    </a>
</div>
