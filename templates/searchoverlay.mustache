    @template local_smartsearch/searchoverlay

    Example context (json):
    {
        "searchtitle": "Search (Ctrl+K)",
        "searchplaceholder": "Search users, courses, activities, settings...",
        "resultslabel": "Search results",
        "viewall": "View all results →",
        "clearsearch": "Clear search",
        "shortcut_close": "Close",
        "shortcut_esc": "Esc",
        "canfeedback": true,
        "feedback_link": "Help us improve Smart Search"
    }
}}
<div id="smartsearch-overlay" class="local-smartsearch smartsearch-overlay" style="display: none;" role="dialog" aria-modal="true" aria-label="{{searchtitle}}">
    <div class="smartsearch-container">
        <div class="smartsearch-panel">
            <div class="smartsearch-header">
                <div class="simplesearchform w-100">
                    <div class="smartsearch-input-wrap">
                        <span class="smartsearch-input-icon text-muted" aria-hidden="true">
                            {{#pix}}i/search, core{{/pix}}
                        </span>
                        <input type="text"
                               id="smartsearch-input"
                               class="form-control border-0 shadow-none smartsearch-input"
                               placeholder="{{searchplaceholder}}"
                               autocomplete="off"
                               aria-label="{{searchplaceholder}}">
                        <button type="button"
                                class="btn btn-clear smartsearch-clear"
                                id="smartsearch-clear"
                                aria-label="{{clearsearch}}"
                                title="{{clearsearch}}"
                                hidden>
                            {{#pix}}e/cancel, core{{/pix}}
                            <span class="visually-hidden">{{clearsearch}}</span>
                        </button>
                        <button type="button"
                                class="smartsearch-esc"
                                id="smartsearch-esc"
                                aria-label="{{shortcut_close}}"
                                title="{{shortcut_esc}}">{{shortcut_esc}}</button>
                    </div>
                </div>
            </div>
            <div class="smartsearch-results" id="smartsearch-results" role="region" aria-live="polite" aria-label="{{resultslabel}}"></div>
            <div class="smartsearch-footer">
                {{#canfeedback}}
                <button type="button" class="btn btn-link btn-sm p-0 smartsearch-feedback-link" id="smartsearch-feedback-open">{{feedback_link}}</button>
                {{/canfeedback}}
                <div class="smartsearch-view-all" id="smartsearch-view-all" style="display: none;">
                    <a href="#" class="smartsearch-view-all-link">{{viewall}}</a>
                </div>
            </div>
        </div>
    </div>
</div>
